<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BabyTrackerMobile.ViewModels"
             x:Class="BabyTrackerMobile.Views.DiaperPage"
             x:DataType="vm:DiaperViewModel"
             Title="Fralda"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <StackLayout Spacing="15" Padding="15">
            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="15">
                    <Label Text="🧷 Registrar Fralda" FontSize="20" FontAttributes="Bold" TextColor="#212121" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Label Text="Horário" TextColor="#757575" FontSize="14" />
                    <TimePicker Time="{Binding DiaperTime}" BackgroundColor="#F5F5F5" TextColor="#212121" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,10">
                        <Label Grid.Column="0" Text="Xixi (Fralda Molhada)" TextColor="#212121" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsWet}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0" Text="Cocô (Fralda Suja)" TextColor="#212121" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsDirty}" />
                    </Grid>

                    <StackLayout IsVisible="{Binding IsDirty}" Spacing="15">
                        <Label Text="Cor das fezes" TextColor="#757575" FontSize="14" />
                        <Picker ItemsSource="{Binding ColorOptions}" SelectedIndex="{Binding SelectedColorIndex}" BackgroundColor="#F5F5F5" TextColor="#212121" TitleColor="#757575" />

                        <Label Text="Consistência" TextColor="#757575" FontSize="14" />
                        <Picker ItemsSource="{Binding ConsistencyOptions}" SelectedIndex="{Binding SelectedConsistencyIndex}" BackgroundColor="#F5F5F5" TextColor="#212121" TitleColor="#757575" />
                    </StackLayout>

                    <Label Text="Observações" TextColor="#757575" FontSize="14" />
                    <Editor Text="{Binding Notes}" HeightRequest="80" BackgroundColor="#F5F5F5" TextColor="#212121" PlaceholderColor="#9E9E9E" />

                    <Button Text="Registrar Fralda 🧷" Command="{Binding RegisterDiaperCommand}" BackgroundColor="#1976D2" TextColor="White" CornerRadius="8" Margin="0,20,0,0" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
