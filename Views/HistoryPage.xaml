<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BabyTrackerMobile.ViewModels"
             xmlns:models="clr-namespace:BabyTrackerMobile.Models"
             x:Class="BabyTrackerMobile.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Histórico"
             BackgroundColor="#F5F5F5">
    <RefreshView Command="{Binding LoadHistoryCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <StackLayout Spacing="15" Padding="15">

                <!-- Date Navigation -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="&lt;" Command="{Binding PreviousDayCommand}" BackgroundColor="Transparent" TextColor="#1976D2" FontSize="20" />
                        <Label Grid.Column="1" Text="{Binding SelectedDateText}" FontAttributes="Bold" FontSize="18" TextColor="#212121" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="&gt;" Command="{Binding NextDayCommand}" BackgroundColor="Transparent" TextColor="#1976D2" FontSize="20" />
                    </Grid>
                </Frame>

                <!-- Summary Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="False">
                        <StackLayout>
                            <Label Text="🍼" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="{Binding HistoryAnalysis.FeedingCount}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#212121" />
                            <Label Text="Mamadas" FontSize="12" HorizontalOptions="Center" TextColor="#757575" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="False">
                        <StackLayout>
                            <Label Text="💧" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="{Binding HistoryAnalysis.WetDiaperCount}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#212121" />
                            <Label Text="Xixi" FontSize="12" HorizontalOptions="Center" TextColor="#757575" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="False">
                        <StackLayout>
                            <Label Text="💩" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="{Binding HistoryAnalysis.DirtyDiaperCount}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#212121" />
                            <Label Text="Cocô" FontSize="12" HorizontalOptions="Center" TextColor="#757575" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Export this day -->
                <Button Text="📤 Enviar resumo deste dia" Command="{Binding ExportCommand}" BackgroundColor="#25D366" TextColor="White" CornerRadius="8" />

                <!-- Feedings -->
                <Label Text="🍼 Mamadas" FontAttributes="Bold" FontSize="16" TextColor="#212121" Margin="0,10,0,5" />
                <StackLayout BindableLayout.ItemsSource="{Binding Feedings}">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhuma mamada registrada neste dia." TextColor="#9E9E9E" FontSize="12" FontAttributes="Italic" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FeedingRecord">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Deletar" BackgroundColor="#C62828" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteFeedingCommand}" CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame CornerRadius="8" Padding="15" Margin="0,0,0,10" BackgroundColor="White" HasShadow="False">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Grid.Column="0" Text="{Binding StartTime, StringFormat='{0:HH:mm}'}" FontAttributes="Bold" TextColor="#1976D2" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ., Converter={StaticResource FeedingDetail}}" Margin="15,0,0,0" TextColor="#212121" VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

                <!-- Diapers -->
                <Label Text="🧷 Fraldas" FontAttributes="Bold" FontSize="16" TextColor="#212121" Margin="0,10,0,5" />
                <StackLayout BindableLayout.ItemsSource="{Binding Diapers}">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhuma fralda registrada neste dia." TextColor="#9E9E9E" FontSize="12" FontAttributes="Italic" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DiaperRecord">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Deletar" BackgroundColor="#C62828" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteDiaperCommand}" CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame CornerRadius="8" Padding="15" Margin="0,0,0,10" BackgroundColor="White" HasShadow="False">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Grid.Column="0" Text="{Binding Time, StringFormat='{0:HH:mm}'}" FontAttributes="Bold" TextColor="#1976D2" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ., Converter={StaticResource DiaperDetail}}" Margin="15,0,0,0" TextColor="#212121" VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

            </StackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
