<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BabyTrackerMobile.ViewModels"
             xmlns:models="clr-namespace:BabyTrackerMobile.Models"
             x:Class="BabyTrackerMobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Configurações"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <StackLayout Spacing="15" Padding="15">

            <!-- Baby Data Card -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="15">
                    <Label Text="👶 Dados do Bebê" FontSize="18" FontAttributes="Bold" TextColor="#212121" />

                    <Label Text="Nome do Bebê" TextColor="#757575" FontSize="14" />
                    <Entry Text="{Binding BabyName}" BackgroundColor="#F5F5F5" TextColor="#212121" PlaceholderColor="#9E9E9E" />

                    <Label Text="Data de Nascimento" TextColor="#757575" FontSize="14" />
                    <DatePicker Date="{Binding BirthDate}" BackgroundColor="#F5F5F5" TextColor="#212121" />

                    <Label Text="Peso ao Nascer (g)" TextColor="#757575" FontSize="14" />
                    <Entry Text="{Binding BirthWeightGrams}" Keyboard="Numeric" BackgroundColor="#F5F5F5" TextColor="#212121" PlaceholderColor="#9E9E9E" />

                    <Label Text="Tipo de Alimentação" TextColor="#757575" FontSize="14" />
                    <Picker ItemsSource="{Binding FeedingTypeOptions}" SelectedIndex="{Binding SelectedFeedingTypeIndex}" BackgroundColor="#F5F5F5" TextColor="#212121" TitleColor="#757575" />

                    <Button Text="Salvar 💾" Command="{Binding SaveBabyCommand}" BackgroundColor="#388E3C" TextColor="White" CornerRadius="8" Margin="0,10,0,0" />
                </StackLayout>
            </Frame>

            <!-- Vitamin Reminders Card -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="12">
                    <Label Text="💊 Lembretes de Vitamina" FontSize="18" FontAttributes="Bold" TextColor="#212121" />
                    <Label Text="Agende um horário diário e receba uma notificação." TextColor="#757575" FontSize="12" />

                    <Label Text="Nome" TextColor="#757575" FontSize="14" Margin="0,8,0,0" />
                    <Entry Text="{Binding NewVitaminName}" BackgroundColor="#F5F5F5" TextColor="#212121" PlaceholderColor="#9E9E9E" />

                    <Label Text="Horário" TextColor="#757575" FontSize="14" />
                    <TimePicker Time="{Binding NewVitaminTime}" BackgroundColor="#F5F5F5" TextColor="#212121" />

                    <Button Text="➕ Adicionar lembrete" Command="{Binding AddVitaminCommand}" BackgroundColor="#7B1FA2" TextColor="White" CornerRadius="8" Margin="0,8,0,0" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,10,0,0" />

                    <Label Text="Lembretes ativos" FontAttributes="Bold" FontSize="14" TextColor="#212121" Margin="0,5,0,0" />
                    <StackLayout BindableLayout.ItemsSource="{Binding Vitamins}">
                        <BindableLayout.EmptyView>
                            <Label Text="Nenhum lembrete cadastrado." TextColor="#9E9E9E" FontSize="12" FontAttributes="Italic" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VitaminSchedule">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Deletar" BackgroundColor="#C62828"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=DeleteVitaminCommand}"
                                                CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding TimeDisplay}" FontAttributes="Bold" TextColor="#7B1FA2" FontSize="16" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" TextColor="#212121" VerticalOptions="Center" />
                                        <Switch Grid.Column="2" IsToggled="{Binding IsActive}" />
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Export Card -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="10">
                    <Label Text="📤 Exportar dados" FontSize="18" FontAttributes="Bold" TextColor="#212121" />
                    <Label Text="Compartilhe o resumo do dia pelo WhatsApp, e-mail ou outro app." TextColor="#757575" FontSize="12" />
                    <Button Text="Enviar resumo de hoje 📱" Command="{Binding ExportDayCommand}" BackgroundColor="#25D366" TextColor="White" CornerRadius="8" Margin="0,8,0,0" />
                </StackLayout>
            </Frame>

            <!-- Medical References Card -->
            <Frame BackgroundColor="#E3F2FD" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="10">
                    <Label Text="📚 Referências Médicas" FontSize="18" FontAttributes="Bold" TextColor="#1976D2" />
                    <Label Text="• OMS: Amamentação exclusiva nos primeiros 6 meses" TextColor="#212121" />
                    <Label Text="• AAP: 8-12 mamadas/dia nas primeiras semanas" TextColor="#212121" />
                    <Label Text="• SBP: Fraldas molhadas indicam hidratação adequada" TextColor="#212121" />
                    <Label Text="• Fezes brancas/acólicas = emergência médica" TextColor="#C62828" FontAttributes="Bold" />
                    <Label Text="Este app não substitui orientação médica profissional." TextColor="#757575" FontSize="12" FontAttributes="Italic" Margin="0,10,0,0" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
