<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BabyTrackerMobile.ViewModels"
             x:Class="BabyTrackerMobile.Views.SleepPage"
             x:DataType="vm:SleepViewModel"
             Title="Sono"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <StackLayout Spacing="15" Padding="15">
            <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False">
                <StackLayout Spacing="15">
                    <Label Text="{Binding FormTitle}" FontSize="20" FontAttributes="Bold" TextColor="#212121" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Label Text="Começou a dormir" TextColor="#757575" FontSize="14" />
                    <TimePicker Time="{Binding StartTime}" BackgroundColor="#F5F5F5" TextColor="#212121" />

                    <Label Text="Acordou" TextColor="#757575" FontSize="14" />
                    <TimePicker Time="{Binding EndTime}" BackgroundColor="#F5F5F5" TextColor="#212121" />

                    <Label Text="{Binding DurationText}" TextColor="#5E35B1" FontSize="15" FontAttributes="Bold" />

                    <Label Text="Recém-nascido dorme 14–17h por dia (NSF/AAP), em vários períodos curtos."
                           TextColor="#757575" FontSize="12" FontAttributes="Italic" />

                    <Button Text="{Binding ActionButtonText}" Command="{Binding RegisterSleepCommand}" BackgroundColor="#5E35B1" TextColor="White" CornerRadius="8" Margin="0,10,0,0" />
                    <Button Text="Cancelar edição" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" BackgroundColor="#E0E0E0" TextColor="#212121" CornerRadius="8" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
