<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BabyTrackerMobile"
             xmlns:conv="clr-namespace:BabyTrackerMobile.Converters"
             x:Class="BabyTrackerMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToPtBrConverter x:Key="EnumToPtBr" />
            <conv:FeedingDetailConverter x:Key="FeedingDetail" />
            <conv:DiaperDetailConverter x:Key="DiaperDetail" />
            <conv:HasTextConverter x:Key="HasText" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
